{
  "name": "rainbow-herd",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/build-verified.mjs",
    "build:game": "node scripts/build-game.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:13k": "npm run build:game && npm run test:game",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern competition/dist --ignore-pattern public/play",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:xr": "node scripts/smoke-xr.mjs",
    "serve:game": "node scripts/serve-game.mjs",
    "test:game": "node scripts/test-game.mjs",
    "playtest:campaign": "node scripts/playtest-campaign.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@gfx/zopfli": "1.0.15",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "aframe": "1.8.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fflate": "^0.7.4",
    "iwer": "2.3.0",
    "playwright": "1.63.0",
    "react-server-dom-webpack": "19.2.6",
    "roadroller": "2.1.0",
    "tailwindcss": "4.2.1",
    "terser": "5.47.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "yazl": "^3.3.1"
  },
  "type": "module",
  "displayName": "Rainbow Herd"
}
